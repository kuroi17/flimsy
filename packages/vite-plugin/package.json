{
  "name": "flimsy-vite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vite dev server plugin for Flimsy visual-to-code synchronization",
  "license": "MIT",
  "author": "kuroi17",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuroi17/flimsy.git"
  },
  "keywords": [
    "vite-plugin",
    "vite",
    "visual-editor",
    "react",
    "tailwind"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs && tsc -p tsconfig.client.json && tsc",
    "pretest": "node scripts/build-client.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "flimsy-core": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "esbuild": "0.28.2",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.5"
  }
}
