{
  "name": "flimsy-dev",
  "version": "0.1.0",
  "type": "module",
  "description": "Direct visual-to-code synchronization tool for modern web development",
  "license": "MIT",
  "author": "kuroi17",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuroi17/flimsy.git"
  },
  "keywords": ["vite", "visual-editor", "tailwind", "react", "dx", "ast", "figma"],
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "flimsy-dev": "./bin/flimsy.js",
    "flimsy": "./bin/flimsy.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vite": {
      "import": "./dist/vite.js",
      "types": "./dist/vite.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "flimsy-core": "workspace:*",
    "flimsy-vite": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

