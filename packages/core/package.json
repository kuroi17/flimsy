{
  "name": "@flimsy/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Core AST parser, JSX location coordinate injector, and file reconciler for Flimsy",
  "license": "MIT",
  "author": "kuroi17",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuroi17/flimsy.git"
  },
  "keywords": ["ast", "recast", "babel", "tailwind-reconciler", "jsx", "tsx"],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/parser": "^7.26.9",
    "@babel/traverse": "^7.26.9",
    "@babel/types": "^7.26.9",
    "magic-string": "^0.30.17",
    "recast": "^0.23.9"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

